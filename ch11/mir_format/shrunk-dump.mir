---
name:            _Z3fooPxx
tracksRegLiveness: true
frameInfo:
  adjustsStack:    true
  hasCalls:        true
  maxCallFrameSize: 0
body:             |
  bb.0:
    liveins: $x10, $x11
  
    %3:gpr = COPY $x11
    %2:gpr = COPY $x10
    BGE %3, $x0, %bb.2
    PseudoBR %bb.1
  
  bb.1:
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY %3
    PseudoCALL target-flags(riscv-call) &_Z3barx, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %4:gpr = COPY $x10
    %0:gpr = COPY %4
  
  bb.2:
    %1:gpr = PHI %3, %bb.0, %0, %bb.1
    %5:gpr = SLLI %1, 3
    %6:gpr = ADD killed %5, %2
    %7:gpr = LD killed %6, 144 :: (load (s64), align 8)
    %8:gpr = nsw ADD killed %7, %1
    $x10 = COPY %8
    PseudoRET implicit $x10

...
